{
  "name": "anagnost",
  "private": true,
  "version": "0.9.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview:ui": "vite --mode mock",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test": "bun test",
    "check": "bun run lint && bun run format:check && bun run test && bun run check:decisions && bun run check:model-languages",
    "check:decisions": "bun scripts/check-decisions.ts",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots",
    "check:model-languages": "bun scripts/check-model-language-coverage.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "~2.6",
    "@tauri-apps/plugin-os": "~2.3.2",
    "i18next": "^25.7.2",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.4.1",
    "react-select": "^5.8.0",
    "sonner": "^2.0.7",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0-alpha-1789764292000",
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/cli": "^2.11.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-i18next": "^6.1.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.6.3",
    "vite": "^6.4.1"
  }
}
